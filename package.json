{
  "name": "life-rpg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @life/web && npm run build -w @life/server",
    "dev:web": "npm run dev -w @life/web",
    "dev:server": "npm run dev -w @life/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
